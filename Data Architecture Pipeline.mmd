flowchart TD
    subgraph SOURCE["SOURCE SYSTEMS (The Fish Farms)"]
        Cameras["Underwater Cameras (MP4)<br>Feeding video"]
        FeedBarge["Feed Barge Controllers (JSON)<br>Feed amounts, pellet type"]
        VetLogs["Veterinary Health Logs (CSV)<br>Sea lice counts, vaccinations"]
        ERP["ERP (Finance/HR/Inventory) (SQL)<br>Staff costs, feed orders"]
        Weather["Weather & Ocean Current Data (API)<br>Temperature, salinity"]
    end

    Cameras --> DataLake
    FeedBarge --> DataLake
    VetLogs --> DataLake
    ERP --> DataLake
    Weather --> DataLake

    subgraph LAKE["RAW DATA LAKE"]
        DataLake["Schema-on-Read - Cheap Storage<br>AWS S3 / Azure ADLS / Google Cloud Storage"]
        DL_Content["• Raw MP4 feeds (unprocessed)<br>• Raw JSON from feed barges<br>• Raw CSV health logs<br>• Raw PDF veterinary reports<br>• Raw weather API dumps"]
    end

    DataLake --> Staging

    subgraph STAGING["STAGING AREA"]
        Staging["Temporary Clean Room<br>Databricks / Azure Synapse Pipelines / AWS Glue"]
        Staging_Content["• Validate data types<br>• Remove duplicates<br>• Handle NULLs<br>• Convert video metadata to feeding_intensity scores via AI"]
    end

    Staging --> Warehouse

    subgraph WAREHOUSE["CENTRAL DATA WAREHOUSE (Enterprise)"]
        Warehouse["Schema-on-Write - Star/Snowflake Schemas<br>Snowflake / Amazon Redshift / Google BigQuery"]
        Facts["FACT TABLES:<br>• Fact_Daily_Growth (avg weight, FCR, temp, salinity)<br>• Fact_Health_Events (lice outbreaks, vaccinations)<br>• Fact_Feed_Consumption"]
        Dims["DIMENSION TABLES:<br>• Dim_Farm_Sites<br>• Dim_Feed_Suppliers<br>• Dim_Date<br>• Dim_Staff<br>• Dim_Water_Quality_Thresholds"]
    end

    Warehouse --> Mart1
    Warehouse --> Mart2
    Warehouse --> Mart3

    subgraph MART1["DATA MART 1: Harvest & Logistics (Tactical)"]
        Mart1["• Biomass by pen<br>• Harvest schedules<br>• Truck/barge locations<br>• Processing plant slots"]
        EndUser1["END USERS: Operations Managers & Logistics<br>• Query: 'Which pens within 30 km of plant are at 5.5 kg today?'<br>• Tool: Power BI / Tableau Dashboard (Live map)"]
        Mart1 --> EndUser1
    end

    subgraph MART2["DATA MART 2: Feed & Nutrition (Tactical)"]
        Mart2["• Feed Conversion Ratio<br>• Pellet type usage<br>• Water temp correlation<br>• Daily feed recommendations"]
        EndUser2["END USERS: Nutritionists & Feed Procurement<br>• Query: 'What is the optimal pellet size for 4kg salmon at 12°C to minimize FCR?'<br>• Tool: Custom Jupyter Notebooks / Python scripts"]
        Mart2 --> EndUser2
    end

    subgraph MART3["DATA MART 3: Veterinary & Health (Tactical)"]
        Mart3["• Lice counts per pen<br>• Vaccination schedules<br>• Mortality rates<br>• Antibiotic usage"]
        EndUser3["END USERS: Fish Health Veterinarians & Biologists<br>• Query: 'Show me all pens with lice > 0.5 per fish so I can deploy cleaner fish this week'<br>• Tool: Veterinary EMR"]
        Mart3 --> EndUser3
    end

    Warehouse --> Execs

    subgraph EXECS["C-Suite Executives (Strategic)"]
        Execs["• Global EBITDA per kilo across all 50 farms over 5 years by region<br>• Tool: Executive Dashboard (Looker / ThoughtSpot)"]
    end

    classDef source fill:#e1f5fe,stroke:#01579b
    classDef lake fill:#f3e5f5,stroke:#4a148c
    classDef staging fill:#fff3e0,stroke:#e65100
    classDef warehouse fill:#e8f5e9,stroke:#1b5e20
    classDef mart fill:#fce4ec,stroke:#880e4f
    classDef enduser fill:#fff9c4,stroke:#f57f17

    class Cameras,FeedBarge,VetLogs,ERP,Weather source
    class DataLake,DL_Content lake
    class Staging,Staging_Content staging
    class Warehouse,Facts,Dims warehouse
    class Mart1,Mart2,Mart3 mart
    class EndUser1,EndUser2,EndUser3,Execs enduser
